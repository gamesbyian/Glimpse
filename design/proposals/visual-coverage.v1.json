  "authority": "docs/planning/current-decisions.md; docs/design/screen-contract.json",
  "identity": "Five-window tactile paper disc for photographs only, stationary hero, 4 primary tabs, Grid fallback",
  "rules": [
    "Never show previewed/selected photo as applied wallpaper.",
    "Never use a reel for settings, Boolean toggles, clock intervals, permissions or a generic command.",
    "Never add a second reel without a user-approved comparison decision.",
    "A five-window disc virtualizes a finite collection; never equate 5 apertures with 5 photos.",
    "Show clear destination on wallpaper apply actions; no silent apply on browse.",
    "Show offline, error, permission, low storage and unsupported capabilities with next action.",
    "Expose accessible buttons, talkback descriptions and reduced-motion equivalent.",
    "No exact five-minute Android background guarantee.",
    "No destructive import/crop/share of originals.",
    "No proposal image is automatically an approved target; physical-device evidence separate."
  ],
