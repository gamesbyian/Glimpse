  "explicitOwnerQuestions": [
    {
      "id": "D01",
      "subject": "Home photographic crescent",
      "decision": "Keep a clearly labeled, tap-only crescent collection cover or use a conventional card?"
    },
    {
      "id": "D02",
      "subject": "Finite photographic reel",
      "decision": "Do physical five-aperture paper rim, zoom, pointer, hero and clipped wheel communicate a usable photo selector?"
    },
    {
      "id": "D03",
      "subject": "Action hierarchy",
      "decision": "At normal and 200% text, do Grid, Next/Previous, Set wallpaper and external sharing appear understandable and sufficiently accessible?"
    },
    {
      "id": "D04",
      "subject": "Selected vs applied",
      "decision": "Is app-acknowledged Home p04 clearly distinguished from selected p12 and unknown current system wallpaper?"
    },
    {
      "id": "D05",
      "subject": "Provider lifetime",
      "decision": "Are locally verified images and pending Google Photos source items correctly represented under offline/revoked/low-storage conditions?"
    },
    {
      "id": "D06",
      "subject": "OS-owned UI and background claims",
      "decision": "Are system picker/sharesheet/Lock availability and best-effort five-minute scheduling portrayed without inventing guaranteed results?"
    },
    {
      "id": "D07",
      "subject": "Restore consequences",
      "decision": "Are preview, Skip/Keep/Separate, committed outcome and Back clearly separate and safely reversible?"
    },
    {
      "id": "D08",
      "subject": "Whole-product visual language",
      "decision": "Do support, recovery, accessibility and native entry points feel like the same Glimpse product as the photographic paper reel?"
    }
  ]
}
